+static int64_t umc_ceil_div(int64_t a, int64_t b)   /* b > 0 */
+{
+  int64_t q = a / b;
+  if( (a % b) != 0 && a > 0 ) q++;
+  return q;
+}
+
+static int64_t umc_floor_div(int64_t a, int64_t b)  /* b > 0 */
+{
+  int64_t q = a / b;
+  if( (a % b) != 0 && a < 0 ) q--;
+  return q;
